
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheApprovedBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::company-build-artifacts"
    },
    {
      "Sid": "ManageObjectsOnlyInTheApprovedBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::company-build-artifacts/*"
    }
  ]
}

